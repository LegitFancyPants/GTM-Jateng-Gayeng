datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
  users    User[]
}

model Project {
  id         String            @id @default(uuid())
  name       String
  wok        String
  branch     Branch            @relation(fields: [branchId], references: [id])
  branchId   String
  odps       Odp[]
  activities ProjectActivity[]
}

model Odp {
  id         String     @id @default(uuid())
  odp        String     @unique
  avai       Int
  used       Int
  total      Int
  lat        Float?
  lon        Float?
  project    Project    @relation(fields: [projectId], references: [id])
  projectId  String
  activities Activity[]
}

model Activity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "sudah_upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?
  
  odp        Odp       @relation(fields: [odpId], references: [id], onDelete: Cascade)
  odpId      String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([odpId, type])
}

model ProjectActivity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, type])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  fullName  String
  role      String   @default("USER") // "USER" | "ADMIN"
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  String?  // Null jika ADMIN
  createdAt DateTime @default(now())
}
